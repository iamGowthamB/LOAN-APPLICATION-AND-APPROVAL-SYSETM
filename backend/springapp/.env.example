# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MySQL Database Settings
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate a secure random string for JWT secret
# You can use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Gmail SMTP Settings (requires App Password)
# 1. Enable 2FA on your Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password (ignore spaces)
MAIL_PASSWORD=your_gmail_app_password

# ==========================================
# DEVELOPMENT NOTES
# ==========================================
# - Database: Create 'loanapp' database in MySQL
# - JWT Secret: Must be at least 256 bits (32 characters)
# - Email: Use Gmail App Password, not regular password
# - Never commit actual .env file to repository